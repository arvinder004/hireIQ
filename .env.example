GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/hireiq
REDIS_URL=redis://localhost:6379
JWT_SECRET_KEY=change_this_to_a_random_256bit_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:5173

# Standard SMTP (e.g. Gmail) — required for sending interview invites
# If using Gmail, you MUST use an App Password, not your normal password.
# 1. Turn on 2-Step Verification in your Google Account
# 2. Go to Security -> App Passwords and generate a 16-letter password
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_letter_app_password